doctor_windows() {
    DOC_LEG=windows
    hdr 'WINDOWS leg (OpenMS.dll, the C# suite, the four gates - the pre-push gate)'
    d_file docker/windows/Dockerfile    'part of the docker landing'
    d_file docker/windows/entrypoint.ps1 'part of the docker landing'

    if [ "$HOST_KIND" != windows ]; then
        d_bad "this host is '$HOST_KIND': the Windows leg cannot run here at all"
        info '  FIX: run the Windows leg on a Windows host. The Linux leg is unaffected;'
        info '       CI on push remains the only other path to an OpenMS.dll.'
        return 0
    fi

    # --- the Containers optional feature (the gate nobody anticipated) ---
    cstate=$(ps_run "(Get-CimInstance Win32_OptionalFeature -Filter \"Name='Containers'\").InstallState" 2>/dev/null || true)
    case ${cstate:-} in
        1) d_ok 'Windows optional feature "Containers": InstallState=1 (Enabled)' ;;
        2) d_bad 'Windows optional feature "Containers": InstallState=2 (DISABLED) - no Windows container can start'
           remedy_containers_feature ;;
        3) d_bad 'Windows optional feature "Containers": InstallState=3 (Absent - payload removed)'
           remedy_containers_feature ;;
        '') d_warn 'could not query the "Containers" optional feature (no PowerShell?)' ;;
        *) d_bad "Windows optional feature \"Containers\": InstallState=$cstate (not Enabled)"
           remedy_containers_feature ;;
    esac
    csvc=$(ps_run "if (Get-Service cexecsvc -ErrorAction SilentlyContinue) {'present'} else {'absent'}" 2>/dev/null || true)
    if [ "${csvc:-}" = present ]; then
        d_ok 'service cexecsvc: present'
    else
        d_bad 'service cexecsvc: absent - the container execution service does not exist until the feature is enabled AND the machine has rebooted'
    fi

    # --- the Windows engine itself ---
    if ! have docker; then
        d_skip 'engine checks skipped: no docker CLI'
        return 0
    fi
    if weo=$(engine_os windows); then
        set -- $weo
        if [ "${1:-}" = windows ]; then
            d_ok "windows engine reachable: server ${1:-?} ${2:-?} via ${FLCI_WINDOWS_DOCKER_HOST:-$WINDOWS_PIPE}"
        else
            d_bad "the windows pipe answered but reports OSType='${1:-?}' - Docker Desktop is not running a Windows daemon"
            remedy_windows_engine
        fi
        iso=$(dkw info --format '{{.Isolation}}' 2>/dev/null | tr -d '\r' || true)
        d_info "default isolation: ${iso:-unknown} (process is opt-in on a client SKU: --isolation=process)"
        if image_present windows "$WINDOWS_IMAGE"; then
            d_ok "image $WINDOWS_IMAGE present"
            # python is NOT optional: regression-runner.ps1 shells out to a bare "python"
            out=$(dkw run --rm "$WINDOWS_IMAGE" cmd /c 'python --version' 2>/dev/null | tr -d '\r' | tail -1 || true)
            if [ -n "$out" ]; then d_ok "in-image python: $out"; else d_bad 'in-image python: absent (regression-runner.ps1 shells out to a bare "python")'; fi
            out=$(dkw run --rm "$WINDOWS_IMAGE" cmd /c 'if exist C:\contrib (echo present) else (echo MISSING)' 2>/dev/null | tr -d '\r' | tail -1 || true)
            if [ "$out" = present ]; then d_ok 'in-image contrib tarball: extracted at C:\contrib'; else d_bad "in-image contrib tarball at C:\\contrib: ${out:-unreadable}"; fi
            out=$(dkw run --rm "$WINDOWS_IMAGE" powershell -NoProfile -Command '(Get-Culture).Name' 2>/dev/null | tr -d '\r' | tail -1 || true)
            if [ "$out" = 'en-US' ]; then
                d_ok 'in-image locale: en-US'
            else
                d_bad "in-image locale: ${out:-unreadable} - MUST be en-US, or double.Parse(\"674.6919\") returns 6746919 and every m/z is off by 10^4"
            fi
        else
            d_bad "image $WINDOWS_IMAGE is absent"
            remedy_build_windows_image
            d_skip 'in-image python / contrib / locale probes skipped: no image'
        fi
        st=$(dkw ps -a --filter "name=^${WIN_CONTAINER}\$" --format '{{.Status}}' 2>/dev/null | tr -d '\r' || true)
        d_info "long-lived container $WIN_CONTAINER: ${st:-not created}"
    else
        d_bad "the windows docker engine is NOT reachable at ${FLCI_WINDOWS_DOCKER_HOST:-$WINDOWS_PIPE}"
        remedy_windows_engine
        d_skip 'isolation / image / in-image python, contrib and locale probes skipped: the windows engine is down'
    fi

    # --- the Thermo DLLs: HOST state, absent is a hard failure, never a skip ---
    hdr 'Thermo iAPI DLLs (host state - ci clean never touches them)'
    if [ -n "${THERMO_DLL_PASSPHRASE:-}" ]; then
        d_info 'THERMO_DLL_PASSPHRASE: set in this environment (the value is never printed, logged or passed to a container)'
    else
        d_info 'THERMO_DLL_PASSPHRASE: not set (only needed for the one-time decrypt)'
    fi
    if ! exp=$(thermo_expected) || [ -z "$exp" ]; then
        d_bad "could not parse the Thermo references out of $CSPROJ_REL"
        return 0
    fi
    act=$(thermo_actual 2>/dev/null || true)
    missing=0
    nexp=0
    for row in $exp; do
        nexp=$((nexp + 1))
        f=${row%%|*}
        rest=${row#*|}
        asm=${rest%%|*}
        rest=${rest#*|}
        ver=${rest%%|*}
        pkt=${rest#*|}
        if [ ! -f "$REPO_ROOT/FlashIDA/dependencies/$f" ]; then
            d_bad "$f ABSENT (expected $asm $ver, token $pkt)"
            missing=$((missing + 1))
            continue
        fi
        got=$(printf '%s\n' "$act" | grep -i "^$f|" | head -1 || true)
        if [ -z "$got" ]; then
            d_ok "$f present (identity not read - no PowerShell)"
            continue
        fi
        gasm=$(printf '%s' "$got" | cut -d'|' -f2)
        gver=$(printf '%s' "$got" | cut -d'|' -f3)
        gpkt=$(printf '%s' "$got" | cut -d'|' -f4)
        if [ "$gasm" = "$asm" ] && [ "$gver" = "$ver" ] && [ "$gpkt" = "$pkt" ]; then
            d_ok "$f present, identity matches Flash.csproj ($gasm $gver $gpkt)"
        else
            d_bad "$f IDENTITY DRIFT: csproj wants $asm $ver $pkt, the file is $gasm $gver $gpkt"
            info '  Both csprojs carry <SpecificVersion>False</SpecificVersion> and App.config has no'
            info '  binding redirect, so NOTHING else in the system can detect this.'
        fi
    done
    if [ "$missing" -gt 0 ]; then
        info "  $missing of $nexp proprietary DLLs are not decrypted - the C# build cannot run."
        remedy_thermo
    fi
}

doctor_compare_ci() {
    hdr 'compare-ci (informational, never a gate)'
    say '  CI configures the library WITH_GUI=ON; the container configures OFF. The DLL the'
    say '  local ABI and golden results depend on therefore comes from a differently'
    say '  configured library build. CI also links a different DLL every run by construction,'
    say '  so the two sha256 values ALWAYS differ - this comparison exists to make a suspected'
    say '  divergence checkable in one command, not to gate anything.'
    if ! have gh; then
        d_warn '--compare-ci could not run: the GitHub CLI (gh) is not on PATH'
        info '  FIX: install gh and run: gh auth login'
        return 0
    fi
    tmp=${TMPDIR:-/tmp}/flci-compare-ci.$$
    mkdir -p "$tmp"
    runid=$(gh run list --workflow flashida-ci.yml --status success --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)
    if [ -z "$runid" ]; then
        d_warn '--compare-ci could not run: no successful flashida-ci.yml run was returned by gh'
        rm -rf "$tmp"
        return 0
    fi
    d_info "latest green CI run: $runid"
    if gh run download "$runid" -n openms-fresh-dll -D "$tmp" >/dev/null 2>&1; then
        remote=$(find "$tmp" -name 'OpenMS.dll' | head -1 || true)
        if [ -n "$remote" ] && have sha256sum; then
            d_info "CI      OpenMS.dll sha256: $(sha256sum "$remote" | cut -d' ' -f1)"
        fi
    else
        d_warn "could not download artifact openms-fresh-dll from run $runid"
    fi
    localdll=$REPO_ROOT/$BUILD_MSVC_REL/bin/OpenMS.dll
    if [ -f "$localdll" ] && have sha256sum; then
        d_info "local   OpenMS.dll sha256: $(sha256sum "$localdll" | cut -d' ' -f1)"
    else
        d_info "local   OpenMS.dll: not built yet ($BUILD_MSVC_REL/bin/OpenMS.dll)"
    fi
    say '  CI configure line (from the frozen workflow):'
    grep -n -A6 'cmake -S OpenMS' "$REPO_ROOT/$WORKFLOW_REL" 2>/dev/null | sed 's/^/    /' | head -12 || true
    say '  container configure line (from docker/windows):'
    if [ -f "$REPO_ROOT/docker/windows/entrypoint.ps1" ]; then
        grep -n -A6 'cmake -S' "$REPO_ROOT/docker/windows/entrypoint.ps1" 2>/dev/null | sed 's/^/    /' | head -12 || true
    else
        say '    docker/windows/entrypoint.ps1 is not present yet'
    fi
    rm -rf "$tmp"
}

cmd_doctor() {
    compare_ci=0
    while [ $# -gt 0 ]; do
        case $1 in
            --compare-ci) compare_ci=1; shift ;;
            -*) finish USAGE "unknown flag for 'ci doctor': $1" ;;
            *)  finish USAGE "'ci doctor' takes no positional arguments (got: $1)" ;;
        esac
    done
    say 'ci doctor - host prerequisites for the two containers'
    say '            every failure below prints the exact command that fixes it'
    doctor_common
    doctor_linux
    doctor_windows
    if [ "$compare_ci" -eq 1 ]; then doctor_compare_ci; fi

    hdr 'summary'
    say "  failures: $DOC_FAIL   warnings: $DOC_WARN   not-checked: $DOC_SKIP"
    if [ "$DOC_LINUX_FAIL" -eq 0 ]; then say '  LINUX leg:   READY'; else say "  LINUX leg:   NOT READY ($DOC_LINUX_FAIL blocking check(s) above)"; fi
    if [ "$DOC_WIN_FAIL" -eq 0 ]; then say '  WINDOWS leg: READY'; else say "  WINDOWS leg: NOT READY ($DOC_WIN_FAIL blocking check(s) above)"; fi
    say ''
    say '  Reminder: a green container is never "green at this SHA" - it verifies your'
    say '  dirty working tree. CI on push stays the authority for MSVC, floats and goldens.'

    ranmsg="prerequisite checks only (no build, no test, no container run)"
    if [ "$DOC_FAIL" -gt 0 ]; then
        if [ "$DOC_LINUX_FAIL" -eq 0 ]; then
            finish INFRA "$DOC_FAIL prerequisite check(s) failed: LINUX leg READY, WINDOWS leg NOT READY - fixes are printed above; $ranmsg"
        elif [ "$DOC_WIN_FAIL" -eq 0 ]; then
            finish INFRA "$DOC_FAIL prerequisite check(s) failed: WINDOWS leg READY, LINUX leg NOT READY - fixes are printed above; $ranmsg"
        else
            finish INFRA "$DOC_FAIL prerequisite check(s) failed: NEITHER leg is ready - fixes are printed above; $ranmsg"
        fi
    fi
    if [ "$DOC_SKIP" -gt 0 ]; then
        finish PARTIAL "$DOC_SKIP prerequisite check(s) could not be evaluated (see [SKIP] above); both legs otherwise READY; $ranmsg"
    fi
    finish PASS "every host prerequisite for both legs is satisfied ($DOC_WARN warning(s)); $ranmsg"
}

# ===========================================================================
#  shared run plumbing
