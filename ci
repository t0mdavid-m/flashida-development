#!/bin/sh
# shellcheck shell=sh
# shellcheck disable=SC3040,SC1007,SC2012,SC2329
# =============================================================================
#  ci - the single local command surface for FLASHIda's dockerised verification
# =============================================================================
#
#  Spec: docs/superpowers/specs/2026-08-27-dockerized-local-ci-design.md
#        section 10 (the command surface) and section 6 (the exit-code contract).
#
#  There is ONE dispatcher. ci.ps1 is a thin shim that calls this file, so no
#  second command surface and no second parser exists.
#
#  ---------------------------------------------------------------------------
#  THE VERDICT CONTRACT (spec section 6) - read this before changing anything
#  ---------------------------------------------------------------------------
#  * Every subcommand exits 0 ONLY if every gate it ran passed.
#  * The LAST line of every run is exactly one of:
#        PASS: <what was verified>
#        FAIL: <first failing gate>
#        PARTIAL: <what did not run> - NOT CI-EQUIVALENT
#    A human who reads only that line is never misled. A skipped tier can never
#    read as a pass: PARTIAL always exits non-zero.
#  * There is no "|| true" on any gate in this file, and no flag disables the
#    end-of-run tree assertions.
#
#  EXIT CODES (distinct, so a caller can tell the four apart)
#      0   PASS         every gate that ran, passed, and nothing was skipped
#      1   FAIL         a gate, a test or a tree assertion failed
#      2   PARTIAL      something CI does was NOT run here (never CI-equivalent)
#      3   INFRA        prerequisite/infrastructure failure - docker, an engine,
#                       an image, the Thermo DLLs, a missing repo file.
#                       Nothing was verified. "ci doctor" names every fix.
#      64  USAGE        misuse: unknown subcommand, bad flag, missing argument
#
#  ---------------------------------------------------------------------------
#  PORTABILITY (owner decision D5) - this file runs on any dev machine
#  ---------------------------------------------------------------------------
#  * The repo root is resolved from THIS SCRIPT'S OWN LOCATION. No absolute host
#    path is baked in anywhere. Every mount is derived from that root.
#  * No secret is ever written, echoed or passed on a command line.
#    THERMO_DLL_PASSPHRASE is read by the host-side openssl command the operator
#    runs; "ci" only ever reports whether the variable is SET.
#  * Engines are addressed by their stable named pipes, never by
#    "docker context use" - Docker Desktop re-points the generic docker_engine
#    pipe when it switches. On a non-Windows host the default endpoint is used.
#  * Every path handed to docker goes through host_path(), which uses cygpath on
#    Git Bash. MSYS_NO_PATHCONV=1 is set for every docker call or MSYS rewrites
#    container paths into drive letters.
#
#  ---------------------------------------------------------------------------
#  CONTRACTS THIS FILE DEPENDS ON (files owned by the container work, not here)
#  ---------------------------------------------------------------------------
#  1. docker/ci-lists.sh - the only reader of the frozen workflow file. Verified
#     against the committed script: subcommands targets | branches | ctest-regex
#     | pins | selftest (aliases self-test, --self-test), exit 2 = fail-closed
#     parse, exit 3 = reconciliation failure, exit 64 = usage. "ci lists" runs
#     "selftest" INSIDE the Linux container, because on this host gawk, GNU sed
#     and GNU grep all silently strip CR: a parser validated here reads 26
#     targets and 0 under container mawk.
#     The LINUX entrypoint runs that same self-test as its own step 1 and ends
#     PARTIAL when it is skipped (FLCI_SELF_TEST=0), which is why "ci cpp" does
#     not start a redundant second copy.
#     The WINDOWS entrypoint deliberately does NOT: the self-test needs the
#     Linux container, and Docker Desktop runs one engine at a time. That lane
#     only CONSUMES "ci-lists.sh targets" and fails closed below its -MinTargets
#     floor. So on "ci dll" / "ci cs" / "ci golden-diff" / "ci cpp --msvc" the
#     mawk self-test does not run at all - run "ci lists" on the Linux engine
#     after any edit to the workflow file or to the parser.
#  2. Linux entrypoint: it IS the image's ENTRYPOINT (/entrypoint.sh, CMD help),
#     so the dispatcher passes only a subcommand and options:
#       all|configure|build|test|shell [--release|--debug] [--tier fast|full]
#       [--slow-threshold SEC] [--jobs N] [--build-dir PATH] [target ...]
#  3. Windows entrypoint, baked into the image (the bind-mount copy at
#     C:\repo\docker\windows\entrypoint.ps1 is for entrypoint development):
#       powershell -NoProfile -ExecutionPolicy Bypass
#         -File C:\flci\entrypoint.ps1 -Command <dll|cs|golden-capture|cpp>
#         [-Filter <where>] [-Target <string[]>]
#     ("ci golden-diff" maps to -Command golden-capture; -Target is an ARRAY,
#      which is why the cpp phase alone is invoked through -Command, not -File.)
#  4. BOTH entrypoints implement the section 6 verdict contract: their LAST line
#     is "PASS: ...", "FAIL: ..." or "PARTIAL: ... NOT CI-EQUIVALENT", and the
#     exit code agrees with it. The dispatcher reads that line, cross-checks it
#     against the exit code, and REFUSES to report a pass when the line is
#     missing - the failure mode this design exists to prevent is a run that
#     verified nothing and returned 0.
#
#  ---------------------------------------------------------------------------
#  WHAT THIS TOOL MAY NOT DECIDE (spec section 1)
#  ---------------------------------------------------------------------------
#  The containers verify YOUR WORKING TREE, dirty. CI verifies a COMMIT from a
#  clean recursive checkout. "Green containers" is never "green at this SHA".
#  Linux is authoritative for "gcc compiles this" and never for a float or a
#  golden. There is deliberately no "ci golden-promote" (promotion is a bare
#  host-side cp) and no "--keep-dll".
# =============================================================================

set -eu
# pipefail where the shell has it (bash, ksh, busybox ash); harmless where not.
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# ---------------------------------------------------------------------------
# Repo root, from this script's own location (D5). No absolute path is baked in.
# ---------------------------------------------------------------------------
flci_self=$0
if [ -L "$flci_self" ]; then
    flci_link=$(ls -ld -- "$flci_self" | sed 's/^.*-> //')
    case $flci_link in
        /*) flci_self=$flci_link ;;
        *)  flci_self=$(dirname -- "$flci_self")/$flci_link ;;
    esac
fi
REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$flci_self")" && pwd -P)

# ---------------------------------------------------------------------------
# Constants. Every one is overridable from the environment so a second session
# (or a second machine) can run its own images and volumes side by side.
# ---------------------------------------------------------------------------
FLCI_TAG=${FLCI_TAG:-latest}
LINUX_IMAGE=${FLCI_LINUX_IMAGE:-flashida-linux:$FLCI_TAG}
WINDOWS_IMAGE=${FLCI_WINDOWS_IMAGE:-flashida-win:$FLCI_TAG}
WIN_CONTAINER=${FLCI_WINDOWS_CONTAINER:-flashida-win}

LINUX_PIPE=${FLCI_LINUX_DOCKER_HOST:-npipe:////./pipe/dockerDesktopLinuxEngine}
WINDOWS_PIPE=${FLCI_WINDOWS_DOCKER_HOST:-npipe:////./pipe/dockerDesktopWindowsEngine}

VOL_BUILD_REL=${FLCI_VOL_BUILD_REL:-flashida-build-linux-rel}
VOL_BUILD_DBG=${FLCI_VOL_BUILD_DBG:-flashida-build-linux-dbg}
VOL_CCACHE_LINUX=${FLCI_VOL_CCACHE_LINUX:-flashida-ccache-linux}
VOL_CCACHE_MSVC=${FLCI_VOL_CCACHE_MSVC:-flashida-ccache-msvc}

# Never "OpenMS/build" - that name is reserved for a CI-shaped tree (spec 6).
BUILD_REL_REL=OpenMS/cmake-build-linux-release
BUILD_DBG_REL=OpenMS/cmake-build-linux-debug
BUILD_MSVC_REL=OpenMS/cmake-build-msvc-release
BUILD_MSVC_DBG=OpenMS/cmake-build-msvc-debug

LINUX_NETWORK=${FLCI_LINUX_NETWORK:-none}
SLOW_THRESHOLD_DEFAULT=2

WORKFLOW_REL=.github/workflows/flashida-ci.yml
STATE_DIR=$REPO_ROOT/.container-out
STATE_FILE=$STATE_DIR/ci-all-state.env

# The five files regression-runner.ps1 and nunit drop at the repo root
# (spec 6, tree pollution 2 and 3). Deleted only if THIS run created them.
# TestResults.filtered.xml is the sixth: the entrypoint writes it for a filtered
# run so the bridge-smoke gate cannot read it. The parent .gitignore lists the
# other five by name.
STRAY_FILES='TestResults.xml TestResults.filtered.xml RegenResults.xml test_inclusion_list.txt test_fasta.fasta test_target_log.log'

# The five proprietary Thermo assemblies. Names, versions and public key tokens
# are PARSED out of Flash.csproj at run time (parse, never copy - spec 5), so
# this list can never drift from the project that consumes them.
CSPROJ_REL=FlashIDA/src/Flash/Flash.csproj

case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*) HOST_KIND=windows ;;
    Linux)                HOST_KIND=linux ;;
    Darwin)               HOST_KIND=darwin ;;
    *)                    HOST_KIND=unknown ;;
esac

# ---------------------------------------------------------------------------
# Output helpers. Everything is ASCII: this text is read in a Windows console
# whose code page is not UTF-8.
# ---------------------------------------------------------------------------
say()  { printf '%s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
hdr()  { printf '\n=== %s ===\n' "$*"; }

FLCI_CMD=ci
FLCI_VERDICT_DONE=0
CLEAN_STRAYS=0          # 1 once a subcommand may create the five stray files
RESTORE_DLL=0           # 1 once a subcommand may swap FlashIDA/dll
STRAYS_BEFORE=''        # stray names that already existed when the run started
GOLDEN_BASELINE=''      # git status of FlashIDA/test-data when the run started
GOLDEN_BASELINE_TAKEN=0

# ---------------------------------------------------------------------------
# docker plumbing
# ---------------------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

host_path() {
    # Absolute host path in a form docker accepts on this platform.
    if have cygpath; then cygpath -m -- "$1"; else printf '%s' "$1"; fi
}

# shellcheck disable=SC2086  # $endpoint is deliberately word-split (it is "-H x" or empty)
docker_at() {
    endpoint=$1; shift
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker $endpoint "$@"
}

linux_endpoint() {
    if [ "$HOST_KIND" = windows ]; then printf '%s' "-H $LINUX_PIPE"; else printf '%s' ''; fi
}

windows_endpoint() {
    printf '%s' "-H $WINDOWS_PIPE"
}

dkl() { docker_at "$(linux_endpoint)" "$@"; }
dkw() { docker_at "$(windows_endpoint)" "$@"; }

with_timeout() {
    secs=$1; shift
    if have timeout; then timeout "$secs" "$@"; else "$@"; fi
}

# shellcheck disable=SC2086  # $ep is deliberately word-split (it is "-H x" or empty)
engine_os() {
    # $1 = "linux" | "windows". Prints "<os> <version>"; non-zero if the engine
    # is not reachable. No pipe here on purpose: the exit code must be docker's
    # even on a shell without pipefail.
    if [ "$1" = linux ]; then ep=$(linux_endpoint); else ep=$(windows_endpoint); fi
    if have timeout; then
        eo_out=$(MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' timeout 25 \
            docker $ep version --format '{{.Server.Os}} {{.Server.Version}}' 2>/dev/null) || return 1
    else
        eo_out=$(MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' \
            docker $ep version --format '{{.Server.Os}} {{.Server.Version}}' 2>/dev/null) || return 1
    fi
    printf '%s' "$eo_out" | tr -d '\r'
}

image_present() {
    # $1 = linux|windows, $2 = image reference
    if [ "$1" = linux ]; then
        dkl image inspect "$2" >/dev/null 2>&1
    else
        dkw image inspect "$2" >/dev/null 2>&1
    fi
}

volume_present() {
    dkl volume inspect "$1" >/dev/null 2>&1
}

ps_run() {
    # Run a PowerShell one-liner on the host. Returns non-zero if no PowerShell.
    if have powershell.exe; then
        with_timeout 40 powershell.exe -NoProfile -NonInteractive -Command "$1" 2>/dev/null | tr -d '\r'
    elif have pwsh; then
        with_timeout 40 pwsh -NoProfile -NonInteractive -Command "$1" 2>/dev/null | tr -d '\r'
    else
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Remedies. Printed verbatim wherever the corresponding check fails, so the
# operator never has to reconstruct a command from prose.
# ---------------------------------------------------------------------------
remedy_containers_feature() {
    say '    FIX (one UAC prompt, then a MANDATORY REBOOT):'
    say '      # from an ELEVATED PowerShell (Run as Administrator):'
    say '      Enable-WindowsOptionalFeature -Online -FeatureName Containers -All -NoRestart'
    say '      # or, self-elevating from a normal prompt:'
    say "      Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-Command','Enable-WindowsOptionalFeature -Online -FeatureName Containers -All -NoRestart'"
    say '      # THEN REBOOT. cexecsvc and the Windows docker daemon do not exist until you do.'
    say '      # verify afterwards, unelevated:'
    say "      (Get-CimInstance Win32_OptionalFeature -Filter \"Name='Containers'\").InstallState   # must be 1"
    say '      Get-Service cexecsvc                                                       # must exist'
}

remedy_windows_engine() {
    say '    FIX (pick one):'
    say '      a) Docker Desktop runs ONE engine at a time unless the setting'
    say '         SimultaneousWindowsAndLinuxContainers is enabled. Enable it in'
    say '         %APPDATA%\Docker\settings-store.json and restart Docker Desktop;'
    say '         both named pipes are then live at once.'
    say '      b) Switch the daemon yourself, in YOUR OWN terminal:'
    say '           & "$Env:ProgramFiles\Docker\Docker\DockerCli.exe" -SwitchDaemon'
    say '         It takes 20-60 s, may prompt for elevation, and STOPS every running'
    say '         container. "ci" never switches the daemon for you, by design.'
    say '      NOTE: do not use "docker desktop engine use <os>" in tooling - it'
    say '            explicitly stops the other daemon.'
}

remedy_thermo() {
    say '    FIX (host side, the passphrase never reaches a file, a layer or a log):'
    say '      export THERMO_DLL_PASSPHRASE=...        # do not commit it, do not echo it'
    say '      openssl enc -aes-256-cbc -d -pbkdf2 \'
    say '        -in FlashIDA/dependencies/thermo-dlls.zip.enc \'
    say '        -out "$TMPDIR/thermo-dlls.zip" -pass env:THERMO_DLL_PASSPHRASE'
    say '      unzip -o "$TMPDIR/thermo-dlls.zip" -d FlashIDA/dependencies/'
    say '      rm "$TMPDIR/thermo-dlls.zip"'
    say '      # The DLLs are HOST state: "ci clean" never touches them, and they are'
    say '      # never baked into an image layer.'
}

# ---------------------------------------------------------------------------
# End-of-run tree assertions. Unconditional, flagless, and the LAST foreground
# action of every subcommand (spec 7 L4). Returns non-zero if the tree moved.
# ---------------------------------------------------------------------------
golden_baseline_take() {
    if [ "$GOLDEN_BASELINE_TAKEN" -eq 1 ]; then return 0; fi
    GOLDEN_BASELINE_TAKEN=1
    if [ -d "$REPO_ROOT/FlashIDA/.git" ] || [ -f "$REPO_ROOT/FlashIDA/.git" ]; then
        GOLDEN_BASELINE=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -uall -- test-data 2>/dev/null || true)
    else
        GOLDEN_BASELINE=''
    fi
    STRAYS_BEFORE=''
    for f in $STRAY_FILES; do
        if [ -e "$REPO_ROOT/$f" ]; then STRAYS_BEFORE="$STRAYS_BEFORE $f"; fi
    done
}

cleanup_strays() {
    # Delete only the stray root files THIS run created (spec 6, pollution 2/3).
    [ "$CLEAN_STRAYS" -eq 1 ] || return 0
    removed=''
    for f in $STRAY_FILES; do
        [ -e "$REPO_ROOT/$f" ] || continue
        case " $STRAYS_BEFORE " in *" $f "*) continue ;; esac
        rm -f "$REPO_ROOT/$f"
        removed="$removed $f"
    done
    if [ -n "$removed" ]; then info "cleaned stray root files:$removed"; fi
}

restore_dll_dir() {
    # FlashIDA/dll is TRACKED and the Windows leg swaps 4 of its 6 files.
    # There is deliberately no opt-out (spec 6).
    [ "$RESTORE_DLL" -eq 1 ] || return 0
    if ! have git; then
        say ''
        say 'DLL RESTORE: COULD NOT RUN - git is unavailable, so the 4 swapped files in'
        say '  FlashIDA/dll/ were NOT restored. Restore them by hand before committing:'
        say '    git -C FlashIDA checkout -- dll'
        return 1
    fi
    dirty=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -- dll 2>/dev/null || true)
    if [ -n "$dirty" ]; then
        info 'restoring FlashIDA/dll/ after the DLL swap (no --keep-dll exists, by design):'
        printf '%s\n' "$dirty" | sed 's/^/      /'
        git -C "$REPO_ROOT/FlashIDA" checkout -- dll
    fi
    dirty=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -- dll 2>/dev/null || true)
    if [ -n "$dirty" ]; then
        say 'ERROR: FlashIDA/dll/ is still dirty after the restore:'
        printf '%s\n' "$dirty" | sed 's/^/      /'
        return 1
    fi
    return 0
}

assert_goldens_untouched() {
    # The only layer that survives a human running "ci" in their own terminal
    # (PreToolUse hooks never see that). No flag disables it.
    # "Could not check" is not "checked and clean". Only the Windows leg can
    # write into test-data (the Linux lane mounts the repo :ro) and that leg
    # sets RESTORE_DLL, so scope the refusal to runs where it actually ran -
    # otherwise a git-less host would fail even "ci --help".
    if ! have git || [ ! -e "$REPO_ROOT/FlashIDA/.git" ]; then
        [ "$RESTORE_DLL" -eq 1 ] || return 0
        say ''
        say 'GOLDEN GATE: COULD NOT RUN - git is unavailable, or FlashIDA/.git is missing.'
        say '  A container phase that is able to write goldens did run, so this tree is'
        say '  UNVERIFIED, not clean. Check by hand before trusting or committing it:'
        say '    git -C FlashIDA status --porcelain -uall -- test-data'
        return 1
    fi
    now=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -uall -- test-data 2>/dev/null || true)
    if [ "$now" = "$GOLDEN_BASELINE" ]; then return 0; fi

    say ''
    say 'GOLDEN GATE: FlashIDA/test-data changed during this run.'
    say '  Nothing here may write into test-data: log goldens are staged as'
    say '  bin/log-golden-output/<case>/*.normalized, regression TSVs into the'
    say '  -OutputDir, continuity JSONs into bin/continuity-output/.'
    # Only the entries that appeared DURING this run. A tree that was already
    # dirty when the run started is the operator's business, not this run's, and
    # must never be reverted here.
    mkdir -p "$STATE_DIR"
    ag_base=$STATE_DIR/.golden-baseline.$$
    printf '%s\n' "$GOLDEN_BASELINE" > "$ag_base"
    ag_new=$(printf '%s\n' "$now" | grep -Fxv -f "$ag_base" || true)
    rm -f "$ag_base"
    if [ -z "$ag_new" ]; then
        say '  No entry is NEW, so the change is a REMOVAL: something under test-data that was'
        say '  dirty when this run started is no longer dirty (reverted, deleted, or committed'
        say '  by another session). Nothing was reverted here - inspect it yourself:'
        say '    git -C FlashIDA status --porcelain -uall -- test-data'
        return 1
    fi
    say '  entries that appeared DURING this run:'
    printf '%s\n' "$ag_new" | sed 's/^/    /'

    # git status --porcelain v1: two status columns, one space, then the path.
    # Revert exactly those tracked paths; untracked additions are REPORTED and
    # never deleted - removing a file the operator may want to look at is worse.
    printf '%s\n' "$ag_new" | while IFS= read -r ag_line; do
        [ -n "$ag_line" ] || continue
        case $ag_line in
            '??'*) continue ;;
        esac
        ag_path=$(printf '%s' "$ag_line" | cut -c4-)
        [ -n "$ag_path" ] || continue
        if git -C "$REPO_ROOT/FlashIDA" checkout -- "$ag_path" 2>/dev/null; then
            say "    reverted: $ag_path"
        else
            say "    COULD NOT REVERT: $ag_path - do it yourself:"
            say "      git -C FlashIDA checkout -- '$ag_path'"
        fi
    done
    ag_untracked=$(printf '%s\n' "$ag_new" | sed -n 's/^?? //p' || true)
    if [ -n "$ag_untracked" ]; then
        say '  UNTRACKED files were created and were NOT deleted. Remove them yourself:'
        printf '%s\n' "$ag_untracked" | sed 's|^|    rm FlashIDA/|'
    fi
    return 1
}

end_of_run_assertions() {
    rc=0
    cleanup_strays
    restore_dll_dir || rc=1
    assert_goldens_untouched || rc=1
    return $rc
}

# ---------------------------------------------------------------------------
# finish - the ONLY exit path. Runs the end-of-run assertions, then prints
# exactly one verdict line, then exits with the contract's code.
# ---------------------------------------------------------------------------
finish() {
    kind=$1; text=$2
    if end_of_run_assertions; then :; else
        kind=FAIL
        text='the end-of-run tree assertion failed (see the GOLDEN GATE / dll block above)'
    fi
    case $kind in
        PASS)    code=0 ;;
        FAIL)    code=1 ;;
        PARTIAL) code=2 ;;
        INFRA)   code=3; kind=FAIL ;;
        USAGE)   code=64; kind=FAIL ;;
        *)       code=1; kind=FAIL ;;
    esac
    say ''
    verdict_line "$kind" "$text"
    FLCI_VERDICT_DONE=1
    exit "$code"
}

verdict_line() {
    case $1 in
        PASS)    printf 'PASS: %s\n' "$2" ;;
        FAIL)    printf 'FAIL: %s\n' "$2" ;;
        PARTIAL) printf 'PARTIAL: %s - NOT CI-EQUIVALENT\n' "$2" ;;
    esac
}

on_exit() {
    ec=$?
    if [ "$FLCI_VERDICT_DONE" -eq 0 ]; then
        # No exit path skips the tree assertions - not an abort, not a signal.
        cleanup_strays || true
        restore_dll_dir || true
        assert_goldens_untouched || true
        printf '\nFAIL: "%s" aborted before it could report a verdict (exit %s) - nothing is verified\n' \
            "$FLCI_CMD" "$ec"
        if [ "$ec" -eq 0 ]; then ec=1; fi
    fi
    exit "$ec"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<'USAGE'
ci - local verification for FLASHIda (two containers; CI on push stays the backstop)

  ci doctor [--compare-ci]     verify every host prerequisite; name the exact fix for each failure
  ci lists                     parser self-test + reconciliation, under container mawk
  ci cpp [name...]             Linux: build + run. No names = fast tier; names = just those targets
  ci cpp --full                Linux: all parsed targets, ctest -j 6, OMP_NUM_THREADS=1
  ci cpp --debug               Linux: separate Debug build dir
  ci cpp --msvc <name...>      Windows: targeted C++ triage only (there is no --msvc --full)
  ci dll                       Windows: build OpenMS.dll, swap 4 DLLs, assert provenance
  ci cs [filter]               Windows: dll + restore + msbuild + UNFILTERED NUnit + 4 gates + regression
                               a filter makes the run PARTIAL: the gates cannot run
  ci golden-diff               Windows: full compare, cell-level diffs, read-only
  ci all [--resume]            Linux first, Windows last; exits with the worse of the two
  ci clean                     wipe build dirs, bin/, test-output/, restore FlashIDA/dll, delete strays

  flags: --slow-threshold <sec>  fast-tier cutoff, from the previous run's measured
                                 ctest timings (default 2)

EXIT CODES   0 PASS | 1 FAIL | 2 PARTIAL (something did not run) | 3 INFRA (prereq) | 64 USAGE
VERDICT      the last line is always PASS:, FAIL: or PARTIAL:. PARTIAL is never a pass.
             Exit 0 is reserved for a COMPLETE leg: "ci cpp --full", "ci cs", "ci all",
             "ci lists", "ci clean", a clean "ci golden-diff". The fast tier, a named
             target set, "ci dll", "ci cpp --msvc" and "ci cs <filter>" all end PARTIAL
             on success, because each of them skipped a gate CI runs.
NOT HERE     no "ci golden-promote" (promotion is a bare host-side cp) and no "--keep-dll".
NOTE         the containers verify your WORKING TREE, dirty. CI verifies a COMMIT.
USAGE
}

# ===========================================================================
#  doctor - verify every host prerequisite and name the exact fix for each
#           failure. Required by D5: the one-time host prerequisites are a
#           checklist, not tribal knowledge.
# ===========================================================================
DOC_FAIL=0
DOC_WARN=0
DOC_SKIP=0
DOC_LINUX_FAIL=0
DOC_WIN_FAIL=0
DOC_LEG=common

d_ok()   { printf '  [ OK ] %s\n' "$*"; }
d_info() { printf '  [INFO] %s\n' "$*"; }
d_warn() { printf '  [WARN] %s\n' "$*"; DOC_WARN=$((DOC_WARN + 1)); }
d_skip() { printf '  [SKIP] %s\n' "$*"; DOC_SKIP=$((DOC_SKIP + 1)); }
d_bad()  {
    printf '  [FAIL] %s\n' "$*"
    DOC_FAIL=$((DOC_FAIL + 1))
    case $DOC_LEG in
        linux)   DOC_LINUX_FAIL=$((DOC_LINUX_FAIL + 1)) ;;
        windows) DOC_WIN_FAIL=$((DOC_WIN_FAIL + 1)) ;;
        *)       DOC_LINUX_FAIL=$((DOC_LINUX_FAIL + 1)); DOC_WIN_FAIL=$((DOC_WIN_FAIL + 1)) ;;
    esac
}

d_file() {
    # $1 = repo-relative path, $2 = remedy sentence
    if [ -f "$REPO_ROOT/$1" ]; then
        d_ok "$1"
    else
        d_bad "$1 is MISSING"
        info "  FIX: $2"
    fi
}

free_gb() {
    # integer GB free on the filesystem holding the repo. Locale-proof: no
    # decimal separator is ever produced (this host is de-DE, where 2887,5 is
    # not a number to [ -lt ]).
    if [ "$HOST_KIND" = windows ] && have powershell.exe; then
        fg=$(ps_run "[int64]((Get-PSDrive -Name (Split-Path -Qualifier '$(host_path "$REPO_ROOT")').TrimEnd(':')).Free/1GB)" 2>/dev/null || true)
    else
        fg=$(df -Pk "$REPO_ROOT" 2>/dev/null | awk 'NR==2 {printf "%d", $4/1048576}' || true)
    fi
    case $fg in
        ''|*[!0-9]*) printf '%s' '' ;;
        *)           printf '%s' "$fg" ;;
    esac
}

thermo_expected() {
    # PARSE the five proprietary assemblies out of Flash.csproj - never copy the
    # list. Emits: <dllfile>|<assembly>|<version>|<publicKeyToken>
    [ -f "$REPO_ROOT/$CSPROJ_REL" ] || return 1
    awk '
        /<Reference Include=/ {
            s = index($0, "Include=\"")
            if (s > 0) {
                rest = substr($0, s + 9)
                e = index(rest, "\"")
                pending = substr(rest, 1, e - 1)
            } else {
                pending = ""
            }
            next
        }
        /HintPath/ {
            if (pending != "" && index($0, "dependencies") > 0) {
                n = split(pending, a, ",")
                name = a[1]; ver = ""; pkt = ""
                for (i = 2; i <= n; i++) {
                    gsub(/^[ \t]+/, "", a[i])
                    if (index(a[i], "Version=") == 1)        ver = substr(a[i], 9)
                    if (index(a[i], "PublicKeyToken=") == 1) pkt = substr(a[i], 16)
                }
                p = index($0, "dependencies")
                f = substr($0, p + 13)
                q = index(f, "<")
                if (q > 0) f = substr(f, 1, q - 1)
                printf "%s|%s|%s|%s\n", f, name, ver, pkt
            }
            pending = ""
        }
    ' "$REPO_ROOT/$CSPROJ_REL"
}

thermo_actual() {
    # name|assembly|version|pkt for every decrypted DLL, via the same API the
    # post-restore identity gate uses. Empty output if PowerShell is absent.
    [ "$HOST_KIND" = windows ] || return 1
    dep=$(host_path "$REPO_ROOT/FlashIDA/dependencies")
    ps_run "Get-ChildItem -Path '$dep' -Filter *.dll -ErrorAction SilentlyContinue | ForEach-Object { try { \$n = [System.Reflection.AssemblyName]::GetAssemblyName(\$_.FullName); \$t = (\$n.GetPublicKeyToken() | ForEach-Object { \$_.ToString('x2') }) -join ''; '{0}|{1}|{2}|{3}' -f \$_.Name, \$n.Name, \$n.Version, \$t } catch { '{0}|UNREADABLE||' -f \$_.Name } }"
}

doctor_common() {
    DOC_LEG=common
    hdr 'workspace'
    d_info "repo root (resolved from this script's own location): $REPO_ROOT"
    d_file "$WORKFLOW_REL" 'you are not in the FLASHIda parent workspace - run ci from the repo root'
    d_file "$CSPROJ_REL"   'the FlashIDA submodule is not checked out: git submodule update --init --recursive'
    d_file docker/ci-lists.awk 'part of the docker landing - git pull, or land docker/ci-lists.awk'
    d_file docker/ci-lists.sh  'part of the docker landing - git pull, or land docker/ci-lists.sh'
    d_file docker/README.md    'part of the docker landing - git pull, or land docker/README.md'
    d_file OpenMS/CMakeLists.txt 'the OpenMS submodule is not checked out: git submodule update --init --recursive'

    # Line endings, measured on the BYTES the container will execute rather
    # than through git. These files may still be untracked, and then
    # `git ls-files --eol` reports no rows at all - a git-based check would
    # pass vacuously on the exact tree that is broken. A CRLF checkout is
    # invisible here and fatal inside the container ("bad interpreter: ^M").
    crlf_bad=''
    for f in ci docker/ci-lists.sh docker/ci-lists.awk docker/linux/entrypoint.sh; do
        [ -f "$REPO_ROOT/$f" ] || continue
        if [ "$(tr -dc '\r' < "$REPO_ROOT/$f" | wc -c | tr -d ' ')" != 0 ]; then
            crlf_bad="$crlf_bad $f"
        fi
    done
    if [ -n "$crlf_bad" ]; then
        d_bad "CRLF in container-executed script(s):$crlf_bad"
        info '  They die at the shebang inside the container. FIX (no local edits there):'
        info '    rm -rf docker ci && git checkout -- docker ci'
        info '  and make sure the root .gitattributes carries "docker/** text=auto eol=lf".'
    else
        d_ok 'container-executed scripts are LF on disk (ci, ci-lists.sh/.awk, linux entrypoint)'
    fi

    hdr 'host tooling'
    if have docker; then
        d_ok "docker CLI: $(docker --version 2>/dev/null | tr -d '\r')"
    else
        d_bad 'docker CLI not on PATH'
        info '  FIX: install Docker Desktop (Windows) or docker-ce (Linux), then reopen the shell'
    fi
    if have git; then d_ok "git: $(git --version 2>/dev/null | tr -d '\r')"; else d_bad 'git not on PATH'; fi
    if have awk; then d_ok "awk: present ($(command -v awk))"; else d_bad 'awk not on PATH'; fi
    d_info "host: $HOST_KIND"
    if [ "$HOST_KIND" = windows ]; then
        hostloc=$(ps_run '(Get-Culture).Name' 2>/dev/null || true)
        [ -n "$hostloc" ] || hostloc='unknown'
        if [ "$hostloc" = 'en-US' ]; then
            d_info "host locale: $hostloc (the image pins en-US regardless)"
        else
            d_info "host locale: $hostloc - the Windows IMAGE must pin and assert en-US;"
            info '         MockMsScan parses fixtures with a culture-sensitive double.Parse,'
            info '         and under de-DE double.Parse("674.6919") returns 6746919.'
        fi
    fi

    hdr 'disk'
    fgb=$(free_gb)
    if [ -z "$fgb" ]; then
        d_warn 'could not determine free disk space'
    elif [ "$fgb" -lt 20 ]; then
        d_bad "free space on the repo volume: ${fgb} GB - the Linux leg alone needs ~20 GB"
    elif [ "$fgb" -lt 60 ]; then
        d_warn "free space on the repo volume: ${fgb} GB - both legs steady-state need 40-60 GB"
    else
        d_ok "free space on the repo volume: ${fgb} GB"
    fi

    hdr 'git status across all three repos (a dirty tree is what the containers verify)'
    for r in . FlashIDA OpenMS; do
        if [ -e "$REPO_ROOT/$r/.git" ]; then
            n=$(git -C "$REPO_ROOT/$r" status --porcelain 2>/dev/null | wc -l | tr -d " " || true)
            h=$(git -C "$REPO_ROOT/$r" rev-parse --short HEAD 2>/dev/null || echo '?')
            b=$(git -C "$REPO_ROOT/$r" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
            d_info "$r: $b @ $h, $n dirty path(s)"
        else
            d_bad "$r is not a git repo (submodule not initialised?)"
        fi
    done
    gdirty=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -uall -- test-data 2>/dev/null || true)
    if [ -n "$gdirty" ]; then
        d_warn 'FlashIDA/test-data is ALREADY dirty - every run reports golden movement against this baseline'
        printf '%s\n' "$gdirty" | sed 's/^/         /'
        info '  FIX (only if the change is unwanted): git -C FlashIDA checkout -- test-data'
    else
        d_ok 'FlashIDA/test-data is clean'
    fi
    dlldirty=$(git -C "$REPO_ROOT/FlashIDA" status --porcelain -- dll 2>/dev/null || true)
    if [ -n "$dlldirty" ]; then
        d_warn 'FlashIDA/dll is dirty - a previous Windows run did not restore the 4 swapped DLLs'
        info '  FIX: git -C FlashIDA checkout -- dll'
    else
        d_ok 'FlashIDA/dll is clean (the swap is restored)'
    fi
}

