    say "Image $WINDOWS_IMAGE is not built on this engine."
    remedy_build_windows_image
    finish INFRA "the windows image $WINDOWS_IMAGE does not exist - nothing was verified"
}

require_thermo_dlls() {
    n=0
    if exp=$(thermo_expected); then
        # An EMPTY parse is a failure, never a pass. Without this the for-loop
        # below iterates zero times, n stays 0, and the gate returns "all five
        # DLLs are present" for a csproj whose <Reference>/<HintPath> shape
        # moved - the exact fail-open this repo's conventions forbid.
        [ -n "$exp" ] || finish INFRA "parsed ZERO Thermo <Reference> entries out of $CSPROJ_REL - the reference or HintPath shape moved, so this gate cannot tell whether the proprietary DLLs are present. Fix the parser (see 'ci doctor'); it will not pass on an empty parse."
        for row in $exp; do
            f=${row%%|*}
            [ -f "$REPO_ROOT/FlashIDA/dependencies/$f" ] || n=$((n + 1))
        done
    else
        finish INFRA "could not parse the Thermo references out of $CSPROJ_REL"
    fi
    if [ "$n" -eq 0 ]; then return 0; fi
    say "$n proprietary Thermo assemblies are not decrypted in FlashIDA/dependencies/."
    say '  The C# build cannot even compile without them.'
    remedy_thermo
    finish INFRA 'the Thermo iAPI DLLs are absent - the C# leg did not run (this is a failure, never a skip)'
}

# ---------------------------------------------------------------------------
# The yml parser self-test (spec 5). It MUST run under container mawk, never on
# the host: here gawk, GNU sed and GNU grep all silently strip CR, so a parser
# validated on this host reads 26 targets and 0 under mawk - and a 0-target
# parse builds nothing, then runs ctest against an empty build dir, and greens.
#
# The LINUX entrypoint runs this same self-test as its own step 1 and ends
# PARTIAL when it is skipped, so "ci cpp" does not start a redundant copy. The
# WINDOWS entrypoint deliberately does NOT (it needs the Linux engine), so on
# "ci dll" / "ci cs" / "ci golden-diff" / "ci cpp --msvc" this gate runs ONLY if
# you invoke it: "ci lists" is the explicit, standalone form.
# The image's ENTRYPOINT is /entrypoint.sh, so this run overrides it.
# ---------------------------------------------------------------------------
run_lists_selftest() {
    for f in docker/ci-lists.awk docker/ci-lists.sh; do
        if [ ! -f "$REPO_ROOT/$f" ]; then
            say "MISSING: $f - the yml parser is part of the docker landing."
            return 1
        fi
    done
    dkl run --rm --network "$LINUX_NETWORK" \
        --entrypoint sh \
        -v "$(host_path "$REPO_ROOT"):/work:ro" \
        -w /work \
        "$LINUX_IMAGE" /work/docker/ci-lists.sh selftest
}

# ---------------------------------------------------------------------------
# container invocation
# ---------------------------------------------------------------------------
run_container_logged() {
    # $1 = log file; rest = the command. Streams live AND records for parsing.
    #
    # The container's exit code travels through a FILE, not through the
    # pipeline. "set -o pipefail" is not POSIX: on a host whose /bin/sh is dash
    # (Debian, Ubuntu - and this file's shebang is #!/bin/sh) the probe at the
    # top of this script silently does nothing, `cmd | tee` returns TEE's zero,
    # and judge_container_run is handed rc=0 for a container that exited 7.
    # That disarms the one check that catches a container printing "PASS:" and
    # then failing. MEASURED: bash -> rc=7, dash -> rc=0.
    # No rc file, or a non-numeric one, means the command never reported: FAIL.
    rcl_log=$1; shift
    rcl_rc_file=$rcl_log.rc
    rm -f "$rcl_rc_file"
    { rcl_inner=0; "$@" 2>&1 || rcl_inner=$?; printf '%s\n' "$rcl_inner" > "$rcl_rc_file"; } | tee "$rcl_log"
    rcl_rc=$(cat "$rcl_rc_file" 2>/dev/null || true)
    rm -f "$rcl_rc_file"
    case $rcl_rc in
        ''|*[!0-9]*) return 1 ;;
    esac
    return "$rcl_rc"
}

judge_container_run() {
    # $1 = exit code, $2 = log file, $3 = phase label.
    # stdout is ONLY the verdict word (it is captured); every diagnostic goes to
    # stderr, which the operator still sees.
    jc_rc=$1; jc_log=$2; jc_phase=$3
    jc_line=$(flci_result_line "$jc_log")
    if [ -z "$jc_line" ]; then
        {
            say ''
            say "NO VERDICT LINE: the $jc_phase container exited $jc_rc without reporting one."
            say '  A run that verified nothing must never be reported as a pass, so this is a FAIL.'
            say "  Contract (section 6): the entrypoint's LAST line must be PASS:, FAIL: or PARTIAL:."
            say "  Full container output: $jc_log"
        } >&2
        printf '%s' FAIL
        return 0
    fi
    jc_verdict=${jc_line%%:*}
    case $jc_verdict in
        PASS)
            if [ "$jc_rc" -ne 0 ]; then
                {
                    say ''
                    say "CONTRADICTION: the $jc_phase entrypoint reported verdict=PASS but exited $jc_rc."
                    say '  The exit code wins: a contradicted pass is a FAIL.'
                } >&2
                printf '%s' FAIL
                return 0
            fi
            printf '%s' PASS ;;
        FAIL)    printf '%s' FAIL ;;
        PARTIAL) printf '%s' PARTIAL ;;
        *)
            {
                say ''
                say "UNPARSEABLE verdict line for $jc_phase: '$jc_line'"
            } >&2
            printf '%s' FAIL ;;
    esac
}

result_summary() {
    # What the entrypoint itself said, quoted into this dispatcher's verdict.
    rs_line=$(flci_result_line "$1")
    case $rs_line in
        *:\ *) printf '%s' "${rs_line#*: }" ;;
        '')    printf '%s' 'no verdict line from the container' ;;
        *)     printf '%s' "$rs_line" ;;
    esac
}

run_linux_cpp() {
    # $1 build flag (--release|--debug), $2 build dir (repo-relative),
    # $3 volume, $4 tier (fast|full), $5 slow threshold, $6.. = target names
    rl_btype=$1; rl_dir=$2; rl_vol=$3; rl_tier=$4; rl_thr=$5; shift 5
    rl_targets=$*

    # With a :ro bind docker cannot auto-create the mountpoint (spec 3), and the
    # entrypoint fails closed if the build dir does not exist.
    mkdir -p "$REPO_ROOT/$rl_dir"

    rl_log=$(new_logfile "cpp-$rl_tier")
    say "linux container: $rl_btype, tier=$rl_tier, build dir /work/$rl_dir"
    say '  (the entrypoint runs the ci-lists.sh self-test as its own step 1 and ends'
    say '   PARTIAL if that gate is skipped)'
    if [ -n "$rl_targets" ]; then say "targets: $rl_targets"; fi
    rl_rc=0
    # shellcheck disable=SC2086  # rl_targets is validated to be [A-Za-z0-9_.+-] words
    run_container_logged "$rl_log" \
        dkl run --rm \
            --network "$LINUX_NETWORK" \
            -v "$(host_path "$REPO_ROOT"):/work:ro" \
            -v "$rl_vol:/work/$rl_dir" \
            -v "$VOL_CCACHE_LINUX:/ccache" \
            -e CCACHE_DIR=/ccache \
            -e CCACHE_BASEDIR=/work \
            -e CCACHE_MAXSIZE=30G \
            -e OPENMS_DATA_PATH=/work/OpenMS/share/OpenMS \
            -e OMP_NUM_THREADS=1 \
            -w "/work/$rl_dir" \
            "$LINUX_IMAGE" \
            all \
                "$rl_btype" \
                --build-dir "/work/$rl_dir" \
                --tier "$rl_tier" \
                --slow-threshold "$rl_thr" \
                ${rl_targets:+--} $rl_targets || rl_rc=$?
    LAST_LOG=$rl_log
    LAST_VERDICT=$(judge_container_run "$rl_rc" "$rl_log" linux)
}

# Windows container paths differ only cosmetically between what `host_path`
# emits (C:/x/y) and what `docker inspect` reports (C:\x\y), and the drive
# letter case is not stable either. Fold both before comparing.
norm_winpath() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '\\' '/' | sed 's|/*$||'
}

ensure_win_container() {
    # A container is addressed by NAME only. One left over from a DIFFERENT
    # checkout keeps its own C:\repo bind, and one left over from before an
    # image rebuild keeps the old image - so reusing either blind would
    # verify a tree that is not this one and could report PASS for it.
    # Nothing inside the container can detect that, so it is checked here.
    # On ANY doubt the container is removed and recreated: it is a bare
    # `ping -t localhost`, every piece of state lives in the bind mount or
    # in the named ccache volume, so recreating costs seconds and loses
    # nothing. Silently reusing the wrong one costs a false green.
    st=$(dkw ps -a --filter "name=^${WIN_CONTAINER}\$" --format '{{.State}}' 2>/dev/null | tr -d '\r' || true)
    if [ -n "$st" ]; then
        ewc_want=$(host_path "$REPO_ROOT")
        ewc_src=$(dkw inspect -f '{{range .Mounts}}{{if eq .Destination "C:\repo"}}{{.Source}}{{end}}{{end}}' "$WIN_CONTAINER" 2>/dev/null | tr -d '\r' || true)
        ewc_img=$(dkw inspect -f '{{.Config.Image}}' "$WIN_CONTAINER" 2>/dev/null | tr -d '\r' || true)
        if [ "$(norm_winpath "$ewc_src")" != "$(norm_winpath "$ewc_want")" ] ||
           [ "$ewc_img" != "$WINDOWS_IMAGE" ]; then
            say "the existing container $WIN_CONTAINER does not match this checkout or image:"
            info "  its C:\repo bind : ${ewc_src:-<could not be determined>}"
            info "  this checkout    : $ewc_want"
            info "  its image        : ${ewc_img:-<could not be determined>} (want $WINDOWS_IMAGE)"
            info '  removing and recreating it - reusing it would verify a different tree'
            dkw rm -f "$WIN_CONTAINER" >/dev/null 2>&1 || true
            st=''
        fi
    fi
    if [ "$st" = running ]; then
        info "reusing the long-lived container $WIN_CONTAINER (scratch and ccache survive between runs)"
        return 0
    fi
    if [ -n "$st" ]; then
        info "starting the existing container $WIN_CONTAINER (state: $st)"
        dkw start "$WIN_CONTAINER" >/dev/null
        return 0
    fi
    iso=${FLCI_WINDOWS_ISOLATION:-process}
    info "creating $WIN_CONTAINER with --isolation=$iso"
    if ! dkw run -d --name "$WIN_CONTAINER" --isolation="$iso" \
            -v "$(host_path "$REPO_ROOT"):C:\\repo" \
            -v "$VOL_CCACHE_MSVC:C:\\ccache" \
            "$WINDOWS_IMAGE" ping -t localhost >/dev/null 2>&1; then
        if [ "$iso" = process ]; then
            say "isolation=process was refused; falling back to hyperv (costed fallback, spec M4)"
            dkw run -d --name "$WIN_CONTAINER" --isolation=hyperv \
                --memory "${FLCI_WINDOWS_MEMORY:-24g}" --cpus "${FLCI_WINDOWS_CPUS:-20}" \
                -v "$(host_path "$REPO_ROOT"):C:\\repo" \
                -v "$VOL_CCACHE_MSVC:C:\\ccache" \
                "$WINDOWS_IMAGE" ping -t localhost >/dev/null
        else
            finish INFRA "could not start the windows container $WIN_CONTAINER"
        fi
    fi
    got=$(dkw inspect -f '{{.HostConfig.Isolation}}' "$WIN_CONTAINER" 2>/dev/null | tr -d '\r' || true)
    info "container isolation actually in effect: ${got:-unknown}"
}

win_phase_preamble() {
    ensure_win_container
    CLEAN_STRAYS=1
    RESTORE_DLL=1
    say "windows container: -Command $1"
    say '  (the entrypoint parses the target list with "ci-lists.sh targets" and fails closed'
    say '   below its floor, asserts the en-US locale, and restores FlashIDA\dll in its'
    say '   finally block. It does NOT run the mawk parser self-test - that needs the Linux'
    say '   container: run "ci lists" after editing the workflow file or the parser.)'
}

run_windows_phase() {
    # $1 = the entrypoint's -Command value, rest = extra -Param value pairs.
    # -File is used because it propagates the script's exit code EXACTLY
    # (measured: -File returns 7 for `exit 7`; -Command collapses every
    # non-zero to 1).
    rw_phase=$1; shift
    rw_log=$(new_logfile "win-$rw_phase")
    win_phase_preamble "$rw_phase"
    rw_rc=0
    # The entrypoint baked into the image is the one that runs; the bind-mount
    # copy at C:\repo\docker\windows\entrypoint.ps1 exists for developing it.
    # Override with FLCI_WINDOWS_ENTRYPOINT to exec the bind copy instead.
    run_container_logged "$rw_log" \
        dkw exec -w 'C:\repo' "$WIN_CONTAINER" \
            powershell -NoProfile -ExecutionPolicy Bypass \
                -File "${FLCI_WINDOWS_ENTRYPOINT:-C:\\flci\\entrypoint.ps1}" \
                -Command "$rw_phase" "$@" || rw_rc=$?
    LAST_LOG=$rw_log
    LAST_VERDICT=$(judge_container_run "$rw_rc" "$rw_log" windows)
}

run_windows_cpp() {
    # $1 = validated, space-separated target names.
    # This one phase CANNOT use -File: the entrypoint's -Target is [string[]],
    # and under -File "A,B" binds as ONE element (measured), which its
    # unknown-target check then rejects. -Command binds a real array. The cost
    # is that -Command collapses a non-zero exit to 1 - harmless here, because
    # the dispatcher only asks "was it zero", and reads PASS/FAIL/PARTIAL off
    # the entrypoint's own verdict line.
    rwc_targets=$1
    rwc_log=$(new_logfile win-cpp)
    win_phase_preamble cpp
    rwc_list=$(printf '%s' "$rwc_targets" | sed "s/ /','/g")
    rwc_cmd="& '${FLCI_WINDOWS_ENTRYPOINT:-C:\\flci\\entrypoint.ps1}' -Command cpp -Target '$rwc_list'"
    rwc_rc=0
    run_container_logged "$rwc_log" \
        dkw exec -w 'C:\repo' "$WIN_CONTAINER" \
            powershell -NoProfile -ExecutionPolicy Bypass -Command "$rwc_cmd" || rwc_rc=$?
    LAST_LOG=$rwc_log
    LAST_VERDICT=$(judge_container_run "$rwc_rc" "$rwc_log" windows)
}

# ===========================================================================
#  subcommands
# ===========================================================================
cmd_lists() {
    [ $# -eq 0 ] || finish USAGE "'ci lists' takes no arguments (got: $1)"
    require_linux_engine
    require_linux_image
    hdr 'yml parser self-test (under container mawk)'
    if run_lists_selftest; then
        finish PASS 'the C++ target list and the ctest -R alternation parse out of .github/workflows/flashida-ci.yml under container mawk, and reconcile (nothing else ran)'
    fi
    finish FAIL 'the yml parser self-test failed - see the reason above (no build, no test ran)'
}

cmd_cpp() {
    tier=fast
    btype=--release
    btype_label=Release
    build_rel=$BUILD_REL_REL
    vol=$VOL_BUILD_REL
    thr=$SLOW_THRESHOLD_DEFAULT
    msvc=0
    full=0
    targets=''
    while [ $# -gt 0 ]; do
        case $1 in
            --full)  full=1; shift ;;
            --debug) btype=--debug; btype_label=Debug; build_rel=$BUILD_DBG_REL; vol=$VOL_BUILD_DBG; shift ;;
            --msvc)  msvc=1; shift ;;
            --slow-threshold)
                [ $# -ge 2 ] || finish USAGE '--slow-threshold needs a value in seconds'
                case $2 in *[!0-9]*|'') finish USAGE "--slow-threshold takes an integer number of seconds, got '$2'" ;; esac
                thr=$2; shift 2 ;;
            --) shift ;;
            -*) finish USAGE "unknown flag for 'ci cpp': $1" ;;
            *)  targets="$targets $1"; shift ;;
        esac
    done
    # shellcheck disable=SC2086
    set -- $targets
    validate_target_names "$@"
    targets=$*

    if [ "$msvc" -eq 1 ]; then
        [ "$full" -eq 0 ] || finish USAGE 'there is no "ci cpp --msvc --full": running all targets on MSVC locally duplicates the CI job that is authoritative for MSVC. Name the targets you want to triage.'
        [ -n "$targets" ] || finish USAGE '"ci cpp --msvc" is targeted triage only - name at least one test target'
        [ "$btype_label" = Release ] || finish USAGE '"ci cpp --msvc --debug" is not wired up; use CI or ci cpp --debug (linux) instead'
        require_windows_engine
        require_windows_image
        run_windows_cpp "$targets"
        summary=$(result_summary "$LAST_LOG")
        case $LAST_VERDICT in
            PASS)    finish PARTIAL "ran MSVC triage of [$targets] only - the other C++ targets, the C# suite, the four gates and the regression run did not run ($summary)" ;;
            PARTIAL) finish PARTIAL "MSVC triage of [$targets] reported a partial result ($summary)" ;;
            *)       finish FAIL "MSVC triage of [$targets] failed ($summary)" ;;
        esac
    fi

    named=0
    if [ -n "$targets" ]; then
        [ "$full" -eq 0 ] || finish USAGE 'name targets OR pass --full, not both'
        named=1
        # A named set is never tiered by the entrypoint (mode "named"), and
        # --tier full says so out loud in the container log.
        tier=full
    elif [ "$full" -eq 1 ]; then
        tier=full
    fi

    require_linux_engine
    require_linux_image
    # shellcheck disable=SC2086
    run_linux_cpp "$btype" "$build_rel" "$vol" "$tier" "$thr" $targets
    summary=$(result_summary "$LAST_LOG")
    case $LAST_VERDICT in
        PASS)
            if [ "$named" -eq 1 ]; then
                finish PARTIAL "ran only [$targets] on gcc $btype_label - the rest of the ctest set, the C# suite, the four gates and the regression run did not run ($summary)"
            fi
            case $tier in
                full) finish PASS "gcc $btype_label build + the full parsed ctest set ($summary). Not verified here: MSVC, any float value, any golden, and the whole C# side" ;;
                *)    finish PARTIAL "ran the FAST tier only on gcc $btype_label - every test slower than ${thr}s was skipped, and so were the C# suite, the four gates and the regression run ($summary). Use 'ci cpp --full' before you push" ;;
            esac ;;
        PARTIAL) finish PARTIAL "the linux leg reported a partial result ($summary)" ;;
        *)       finish FAIL "the linux leg failed ($summary)" ;;
    esac
}

cmd_dll() {
    [ $# -eq 0 ] || finish USAGE "'ci dll' takes no arguments (got: $1)"
    require_windows_engine
    require_windows_image
    require_thermo_dlls
    run_windows_phase dll
    summary=$(result_summary "$LAST_LOG")
    case $LAST_VERDICT in
        PASS)    finish PARTIAL "built OpenMS.dll, swapped the 4 DLLs and asserted provenance ($summary) - the C# suite, the four gates and the regression run did not run" ;;
        PARTIAL) finish PARTIAL "the DLL leg reported a partial result ($summary)" ;;
        *)       finish FAIL "the DLL build or the provenance gate failed ($summary)" ;;
    esac
}

cmd_cs() {
    filter=''
    if [ $# -gt 0 ]; then
        case $1 in
            -*) finish USAGE "'ci cs' takes an optional NUnit --where filter, not a flag: $1" ;;
        esac
        filter=$1; shift
        [ $# -eq 0 ] || finish USAGE "'ci cs' takes at most one filter argument (quote it)"
    fi
    require_windows_engine
    require_windows_image
    require_thermo_dlls

    if [ -n "$filter" ]; then
        say 'FILTERED RUN: the four fail-closed gates cannot run against a filtered suite.'
        say '  The entrypoint writes TestResults.filtered.xml, a path the bridge-smoke gate'
        say '  deliberately cannot read, and the run is PARTIAL however green the tests are.'
        run_windows_phase cs -Filter "$filter"
        summary=$(result_summary "$LAST_LOG")
        case $LAST_VERDICT in
            FAIL) finish FAIL "the filtered C# run failed ($summary)" ;;
            *)    finish PARTIAL "bridge-smoke and TRACK-CREATE gates did not run; the suite ran FILTERED ($filter), so the 181-test contract, the JSON-capture gate and the test-data-directory gate did not run either ($summary)" ;;
        esac
    fi

    run_windows_phase cs
    summary=$(result_summary "$LAST_LOG")
    case $LAST_VERDICT in
        PASS)
            finish PASS "OpenMS.dll + the 4-DLL swap + the ABI provenance gate + the UNFILTERED NUnit suite + all four gates + the 14-case regression run ($summary). Not verified here: a clean recursive checkout, the cpp-test-build tarball round trip, cold-cache compilation, and the goldens themselves - CI owns those" ;;
        PARTIAL) finish PARTIAL "the C# leg reported a partial result ($summary)" ;;
        *)       finish FAIL "the C# leg failed ($summary)" ;;
    esac
}

cmd_golden_diff() {
    [ $# -eq 0 ] || finish USAGE "'ci golden-diff' takes no arguments (got: $1)"
    require_windows_engine
    require_windows_image
    require_thermo_dlls
    say 'golden-diff is READ-ONLY: nothing here may write into FlashIDA/test-data.'
    say '  Log goldens are staged as bin/log-golden-output/<case>/*.normalized (the engine'
    say '  writes them unconditionally, so LOG_GOLDEN_CAPTURE is never set), regression TSVs'
    say '  into the -OutputDir, continuity JSONs into bin/continuity-output/.'
    # The dispatcher subcommand is "golden-diff" (spec section 10); the entrypoint's
    # phase for the same work is "golden-capture" - it stages, compares and prints
    # the promotion lines, and never writes into the golden tree.
    run_windows_phase golden-capture
    summary=$(result_summary "$LAST_LOG")
    say ''
    say 'PROMOTION (deliberately NOT a ci subcommand - a wrapper is the one shape the golden'
    say '  write guard does not gate): run the printed cp lines yourself, on the host, from'
    say "  $REPO_ROOT"
    say '  Container path C:\repo == the repo root above. Patch only the cells that moved -'
    say '  a whole-file promotion also bakes in this run column order and this run float jitter.'
    say '  A green CI run on the push carrying the golden is the acceptance test for every'
    say '  local capture; prefer the CI phase4-golden-capture artifact for the regression TSVs.'
    case $LAST_VERDICT in
        PASS)    finish PASS "golden comparison completed with no movement ($summary) - read-only, nothing was promoted" ;;
        PARTIAL) finish PARTIAL "the golden comparison reported a partial result ($summary)" ;;
        *)       finish FAIL "goldens moved, or the comparison run failed ($summary) - review the cell-level diff above before promoting anything" ;;
    esac
}

# ---------------------------------------------------------------------------
# ci all - Linux first, Windows LAST (it produces the artifacts a human reviews)
# ---------------------------------------------------------------------------
tree_fingerprint() {
    for r in . FlashIDA OpenMS; do
        [ -e "$REPO_ROOT/$r/.git" ] || continue
        git -C "$REPO_ROOT/$r" rev-parse HEAD 2>/dev/null || true
        git -C "$REPO_ROOT/$r" status --porcelain -uall 2>/dev/null || true
    done
}

tree_fingerprint_hash() {
    if have sha256sum; then tree_fingerprint | sha256sum | cut -d' ' -f1
    else tree_fingerprint | cksum | cut -d' ' -f1
    fi
}

cmd_all() {
    resume=0
    while [ $# -gt 0 ]; do
        case $1 in
            --resume) resume=1; shift ;;
            *) finish USAGE "unknown argument for 'ci all': $1" ;;
        esac
    done
    fp=$(tree_fingerprint_hash)
    linux_verdict=''
    linux_summary=''

    if [ "$resume" -eq 1 ]; then
        if [ ! -f "$STATE_FILE" ]; then
            finish INFRA "there is no phase state to resume ($STATE_FILE does not exist) - run 'ci all' first"
        fi
        # shellcheck disable=SC1090
        . "$STATE_FILE"
        if [ "${FLCI_ALL_FINGERPRINT:-}" != "$fp" ]; then
            say 'The tree changed since the linux leg ran, so its result no longer describes this tree.'
            say '  Re-running BOTH legs rather than reporting a stale pass.'
            resume=0
        else
            linux_verdict=${FLCI_ALL_LINUX_VERDICT:-}
            linux_summary=${FLCI_ALL_LINUX_SUMMARY:-}
            say "resuming: the linux leg was $linux_verdict for exactly these bytes ($linux_summary)"
            if [ "$linux_verdict" != PASS ]; then
                finish FAIL "the linux leg was $linux_verdict in the run being resumed - fix it and run 'ci all' again"
            fi
        fi
    fi

    if [ "$resume" -eq 0 ]; then
        hdr 'leg 1 of 2: LINUX (gcc, full ctest set)'
        require_linux_engine
        require_linux_image
        run_linux_cpp --release "$BUILD_REL_REL" "$VOL_BUILD_REL" full "$SLOW_THRESHOLD_DEFAULT"
        linux_verdict=$LAST_VERDICT
        linux_summary=$(result_summary "$LAST_LOG")
        mkdir -p "$STATE_DIR"
        safe_summary=$(printf '%s' "$linux_summary" | tr -d "'")
        {
            printf 'FLCI_ALL_FINGERPRINT=%s\n' "$fp"
            printf 'FLCI_ALL_LINUX_VERDICT=%s\n' "$linux_verdict"
            printf "FLCI_ALL_LINUX_SUMMARY='%s'\n" "$safe_summary"
        } > "$STATE_FILE"
        if [ "$linux_verdict" != PASS ]; then
            finish FAIL "the linux leg failed ($linux_summary) - the windows leg was not started"
        fi
        say "linux leg: PASS ($linux_summary)"
    fi

    hdr 'leg 2 of 2: WINDOWS (OpenMS.dll, the C# suite, the four gates, the regression run)'
    if ! eo=$(engine_os windows) || case $eo in windows\ *) false ;; *) true ;; esac; then
        windows_unavailable_report
        say ''
        say "  Phase state written to $STATE_FILE."
        say '  Switch Docker Desktop to the Windows engine YOURSELF, then run:'
        say '      ./ci all --resume'
        say '  Until that resume completes, this run is NOT equivalent to a CI run.'
        finish PARTIAL "linux leg PASS ($linux_summary); the Windows leg did not run - no DLL build, no ABI provenance gate, no 181-test suite, no gates, no regression"
    fi
    require_windows_image
    require_thermo_dlls
    run_windows_phase cs
    win_verdict=$LAST_VERDICT
    win_summary=$(result_summary "$LAST_LOG")

    hdr 'ci all summary'
    say "  linux  : $linux_verdict ($linux_summary)"
    say "  windows: $win_verdict ($win_summary)"
    rm -f "$STATE_FILE"
    case $win_verdict in
        PASS)    finish PASS "linux (gcc, full ctest set) and windows (OpenMS.dll + UNFILTERED NUnit + all four gates + regression) both passed. Still only CI verifies a clean recursive checkout, the cpp-test-build round trip, cold-cache compilation and the goldens" ;;
        PARTIAL) finish PARTIAL "linux PASS; the windows leg reported a partial result ($win_summary)" ;;
        *)       finish FAIL "the windows leg failed ($win_summary); the linux leg passed" ;;
    esac
}

cmd_clean() {
    [ $# -eq 0 ] || finish USAGE "'ci clean' takes no arguments (got: $1)"
    hdr 'clean'
    for d in "$BUILD_REL_REL" "$BUILD_DBG_REL" "$BUILD_MSVC_REL" "$BUILD_MSVC_DBG" FlashIDA/bin FlashIDA/test-output; do
        if [ -d "$REPO_ROOT/$d" ]; then
            rm -rf "${REPO_ROOT:?}/$d"
            info "removed $d"
        fi
    done
    for f in $STRAY_FILES; do
        if [ -e "$REPO_ROOT/$f" ]; then rm -f "$REPO_ROOT/$f"; info "removed stray $f"; fi
    done
    if have git && [ -e "$REPO_ROOT/FlashIDA/.git" ]; then
        RESTORE_DLL=1
        info 'FlashIDA/dll will be restored by the end-of-run assertion below'
    fi
    vols_left=0
    if have docker && eo=$(engine_os linux) && case $eo in linux\ *) true ;; *) false ;; esac; then
        for v in "$VOL_BUILD_REL" "$VOL_BUILD_DBG"; do
            if volume_present "$v"; then
                if dkl volume rm "$v" >/dev/null 2>&1; then
                    info "removed build volume $v"
                else
                    info "could not remove volume $v (a container is still using it?) - remove it yourself if you meant to"
                    vols_left=$((vols_left + 1))
                fi
            fi
        done
        info "kept the ccache volumes ($VOL_CCACHE_LINUX, $VOL_CCACHE_MSVC) - wiping them costs a cold rebuild"
    else
        # The host build directory is only a MOUNTPOINT: the build tree itself
        # lives in the named volume (spec section 3). Removing the mountpoint
        # while the volume survives is not a clean, so the verdict must not say
        # the build dirs are gone.
        vols_left=2
        info 'linux engine not reachable: the build VOLUMES were NOT removed, and they hold the'
        info '  actual build trees - only their host mountpoints were deleted. Start the linux'
        info '  engine and re-run "ci clean", or remove them yourself:'
        info "    docker $(linux_endpoint) volume rm $VOL_BUILD_REL $VOL_BUILD_DBG"
    fi
    info 'images were NOT removed: pruning is your call alone, never the tooling (see ci doctor for the footprint)'
    if [ -d "$REPO_ROOT/FlashIDA/dependencies" ]; then
        # No `ls | wc -l` here: with pipefail an empty glob makes ls exit 2 and
        # the whole run aborts.
        ndll=0
        for f in "$REPO_ROOT/FlashIDA/dependencies"/*.dll; do
            [ -e "$f" ] || continue
            ndll=$((ndll + 1))
        done
        info "FlashIDA/dependencies untouched by design (host state): $ndll decrypted DLL(s) still there"
    fi
    if [ "$vols_left" -gt 0 ]; then
        finish PARTIAL "the host build dirs, bin/, test-output/ and the stray root files are gone and FlashIDA/dll is restored, but $vols_left linux build volume(s) still hold the actual build tree - the next build resumes on top of them"
    fi
    finish PASS 'build dirs, bin/, test-output/ and the stray root files are gone; FlashIDA/dll restored; dependencies and images untouched (nothing was built or tested)'
}

# ===========================================================================
#  dispatch
# ===========================================================================
if [ $# -lt 1 ]; then
    usage
    golden_baseline_take
    finish USAGE 'no subcommand given (nothing ran) - the list is above'
fi

FLCI_CMD="ci $1"
sub=$1
shift

# Baseline for the end-of-run tree assertions: taken BEFORE anything runs, so a
# tree that was already dirty is reported by doctor and never blamed on this run.
golden_baseline_take

case $sub in
    doctor)       cmd_doctor "$@" ;;
    lists)        cmd_lists "$@" ;;
    cpp)          cmd_cpp "$@" ;;
    dll)          cmd_dll "$@" ;;
    cs)           cmd_cs "$@" ;;
    golden-diff)  cmd_golden_diff "$@" ;;
    all)          cmd_all "$@" ;;
    clean)        cmd_clean "$@" ;;
    -h|--help|help)
        usage
        finish PASS 'printed the usage text (nothing was built, run or verified)' ;;
    golden-promote)
        usage
        say ''
        say 'There is deliberately no "ci golden-promote". A wrapper is the one command shape the'
        say 'golden write guard does not gate, and a whole-file promotion bakes in this run column'
        say 'order and float jitter. Use "ci golden-diff" and run the cp lines it prints yourself.'
        finish USAGE '"ci golden-promote" does not exist, by design - promotion is a bare host-side cp' ;;
    *)
        usage
        finish USAGE "unknown subcommand '$sub' (nothing ran)" ;;
esac
