LOG_DIR=$STATE_DIR/logs

new_logfile() {
    mkdir -p "$LOG_DIR"
    printf '%s/%s-%s.log' "$LOG_DIR" "$1" "$$"
}

flci_result_line() {
    # The entrypoints' own verdict line (section 6 contract), last one wins.
    # The Windows lane writes CRLF, so strip CR: the anchor still matches with a
    # trailing CR, but the summary quoted into this dispatcher's verdict would
    # carry it into the middle of a line (and into the ci-all state file).
    grep -E '^(PASS|FAIL|PARTIAL):' "$1" 2>/dev/null | tr -d '\r' | tail -1 || true
}

validate_target_names() {
    # Test target names only. Anything else is misuse - and this is also what
    # makes the unquoted expansion of the target list safe.
    for t in "$@"; do
        case $t in
            *[!A-Za-z0-9_.+-]*) finish USAGE "not a valid ctest target name: '$t'" ;;
            '')                 finish USAGE 'empty target name' ;;
        esac
    done
}

require_docker() {
    have docker || finish INFRA 'docker is not on PATH - nothing ran. Fix it, then: ci doctor'
}

require_linux_engine() {
    require_docker
    if eo=$(engine_os linux); then
        case $eo in
            linux\ *) return 0 ;;
        esac
        say "The pipe ${FLCI_LINUX_DOCKER_HOST:-$LINUX_PIPE} answered but reports '$eo'."
    else
        say "The LINUX docker engine is not reachable at ${FLCI_LINUX_DOCKER_HOST:-$LINUX_PIPE}."
    fi
    say '  Start Docker Desktop (or the docker service). If Docker Desktop is currently'
    say '  switched to the Windows engine, see "ci doctor" for the two ways to get both.'
    finish INFRA 'the linux docker engine is unavailable - no build, no ctest, nothing was verified'
}

remedy_build_linux_image() {
    say "    FIX: docker $(linux_endpoint) build -f docker/linux/Dockerfile -t $LINUX_IMAGE docker/linux"
}

remedy_build_windows_image() {
    # The three CI_* args have NO default: the Dockerfile fails closed without
    # them, and their values are PARSED out of the frozen workflow, never typed.
    say '    FIX (the three CI_* build args come from the parser, never from prose):'
    say '      QTV=$(docker/ci-lists.sh pins | sed -n "s/^qt_version=//p")  || exit 1'
    say '      QTA=$(docker/ci-lists.sh pins | sed -n "s/^qt_arch=//p")     || exit 1'
    say '      QTR=$(docker/ci-lists.sh pins | sed -n "s/^qt_archives=//p") || exit 1'
    say "      docker $(windows_endpoint) build -f docker/windows/Dockerfile -t $WINDOWS_IMAGE \\"
    say '        --build-arg CI_QT_VERSION="$QTV" --build-arg CI_QT_ARCH="$QTA" \'
    say '        --build-arg CI_QT_ARCHIVES="$QTR" docker/windows'
}

require_linux_image() {
    if image_present linux "$LINUX_IMAGE"; then return 0; fi
    say "Image $LINUX_IMAGE is not built on this engine."
    remedy_build_linux_image
    finish INFRA "the linux image $LINUX_IMAGE does not exist - nothing was verified"
}

